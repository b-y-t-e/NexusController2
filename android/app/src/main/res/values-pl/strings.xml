    <string name="reject_token">Nieprawidłowy kod parowania. Zeskanuj kod QR jeszcze raz.</string>
    <string name="reject_full">Brak wolnego miejsca dla gracza. Odłącz jednego pada albo spróbuj za chwilę.</string>
    <string name="reject_malformed">Komputer odrzucił połączenie (nieprawidłowe zgłoszenie).</string>
    <string name="reject_unauthenticated">Komputer odrzucił połączenie (brak uwierzytelnienia).</string>
    <string name="reject_rate_limited">Za dużo nieudanych prób. Odczekaj minutę i spróbuj ponownie.</string>
    <string name="reject_unknown">Komputer odrzucił połączenie (kod 0x%1$02X).</string>
