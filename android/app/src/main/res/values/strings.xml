    <!-- Help: written from what the app actually does, not from a template -->
    <string name="help_title">Troubleshooting</string>
    <string name="help_subtitle">Common issues and what to do</string>
    <string name="help_notfound_title">The phone cannot find the PC</string>
    <string name="help_notfound_subtitle">No server appears, or connecting times out</string>
    <string name="help_notfound_1">Press START SERVER on the PC — the ring must read ONLINE and show an address.</string>
    <string name="help_notfound_2">Put both devices on the same Wi-Fi. A guest network often blocks devices from seeing each other.</string>
    <string name="help_notfound_3">Let the phone in through the firewall: TCP 6000 and UDP 6001. The dashboard offers to do it for you.</string>
    <string name="help_notfound_4">If Windows calls that network Public, a rule for private networks does not apply to it. Set the network to private, or open the port for public ones too.</string>
    <string name="help_notfound_5">Another firewall (ESET, Norton, Kaspersky) filters separately and needs its own rule.</string>
    <string name="help_notfound_6">A USB cable sidesteps all of it: enable USB debugging, plug in, choose USB in the app.</string>

    <string name="help_lag_title">Lag or stutter</string>
    <string name="help_lag_subtitle">Presses arrive late</string>
    <string name="help_lag_1">Use a 5 GHz network. 2.4 GHz is usually crowded.</string>
    <string name="help_lag_2">Move closer to the router, or use a USB cable — that path has no radio at all.</string>
    <string name="help_lag_3">Nothing here streams video: the app sends a few hundred bytes a second, so lag is the network, not the load.</string>

    <string name="help_buttons_title">Buttons do nothing in the game</string>
    <string name="help_buttons_subtitle">The pad connects, the game ignores it</string>
    <string name="help_buttons_1">Click the game window so it has focus.</string>
    <string name="help_buttons_2">Check the game reads XInput pads. If it prefers a PlayStation pad, switch this phone to DualShock 4.</string>
    <string name="help_buttons_3">Windows shows only four XInput pads at once, shared with any physical controller. Past four, use DualShock 4 mode — it does not take a slot.</string>
    <string name="help_buttons_4">In Buzz mode, set RPCS3 to Settings → I/O → Emulated Buzz devices → 1 controller.</string>

    <string name="help_stuck_title">Still stuck?</string>
    <string name="help_stuck_body">The dashboard log on the PC records every refused connection and the reason for it.</string>

    <!-- About -->
    <string name="about_title">About</string>
    <string name="about_tagline">Turns this phone into an Xbox 360, DualShock 4 or Buzz! controller for a Windows PC, over Wi-Fi or a USB cable.</string>
    <string name="about_how_title">How it works</string>
    <string name="about_how_body">The phone sends button presses over TCP 6000. The PC turns them into a virtual controller through the ViGEmBus driver, so games see an ordinary gamepad. Nothing leaves your network and nothing is streamed.</string>
    <string name="about_privacy_title">Privacy</string>
    <string name="about_privacy_body">No accounts, no telemetry, no data leaves your LAN. The app talks to one PC, the one whose pairing code you scanned.</string>
    <string name="about_source_body">Built with Jetpack Compose. Source, licences and releases are on GitHub.</string>
    <string name="about_releases">RELEASES ON GITHUB</string>
