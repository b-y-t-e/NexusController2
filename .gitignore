# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/

# What build_release.py assembles: the .exe and the .apk, ready to upload.
release/

# --- Android / Gradle ---
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
android/.kotlin/
*.iml
*.apk
*.aab
*.jks
*.keystore
# Where this machine's key lives and what unlocks it. The key itself is kept
# outside the tree (%APPDATA%\NexusController\signing) so a clean checkout
# cannot delete it; this file only points at it.
android/keystore.properties
# The Gradle wrapper jar must be committed — without it gradlew cannot bootstrap.
!gradle/wrapper/gradle-wrapper.jar

# --- IDE / OS ---
.idea/
.vscode/
# Scratch state from a terminal tool run against this checkout, not part of it.
.mterminal/
Thumbs.db
Desktop.ini
.DS_Store

# --- Runtime artefacts ---
# Settings live in %APPDATA%\NexusController, never in the repo.
settings.json
*.log
Output/

# PyInstaller writes this from the flags in tools/build_exe.py
*.spec
